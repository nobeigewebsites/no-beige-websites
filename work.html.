    <!-- ======================================================
         PROJECT 01 — ROTATING CHAOS
         ====================================================== -->

    <section class="project-case project-case-dark">


      <div class="project-case-head">


        <span class="project-number">
          01
        </span>


        <div>


          <p class="project-kicker">
            GAMING ◆ COMMUNITY ◆ CUSTOM BUILD
          </p>


          <h2>
            ROTATING
            <span>
              CHAOS.
            </span>
          </h2>


        </div>


      </div>



      <div class="project-case-grid">


        <div class="project-case-copy">


          <h3>
            THE BRIEF
          </h3>


          <p>

            Build a Neverwinter guild website that actually feels like
            the guild instead of looking like a generic gaming template.

            It needed personality, fantasy styling, useful guides,
            dungeon mechanics, community information and enough structure
            to handle a frankly ridiculous amount of content.

          </p>



          <h3>
            THE APPROACH
          </h3>


          <p>

            Strong fantasy styling, custom navigation, bold visual hierarchy
            and reusable page systems for guides, builds and dungeon content.

            The website had to feel immersive without becoming impossible to use.

          </p>



          <div class="project-tags">

            <span>
              GAMING
            </span>

            <span>
              COMMUNITY
            </span>

            <span>
              CONTENT HEAVY
            </span>

            <span>
              CUSTOM DESIGN
            </span>

          </div>


        </div>



        <div class="project-case-visual">

          <img
            src="images/rotating-chaos.png"
            alt="Rotating Chaos website"
          >

        </div>


      </div>


    </section>




    <!-- ======================================================
         PROJECT 02 — HFS
         ====================================================== -->

